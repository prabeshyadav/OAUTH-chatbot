# ==========================================
# Database Configuration (Railway Managed Postgres)
# ==========================================
# Railway automatically provides DATABASE_URL when you attach a Postgres service.
DATABASE_URL=postgresql://postgres:password@host:5432/railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db

# ==========================================
# Security & JWT Configuration
# ==========================================
SECRET_KEY=nexusai-secret-key-super-secure-jwt-2026
ALGORITHM=HS256

# ==========================================
# CORS & Deployment URLs (Railway Setup)
# ==========================================
# Set CORS_ORIGINS to '*' or your specific Railway frontend URL (e.g., https://frontend-xxx.up.railway.app)
CORS_ORIGINS=*

# Frontend URL used for Google OAuth callback redirect back to the app UI
FRONTEND_URL=https://your-frontend-domain.up.railway.app

# ==========================================
# Google Gemini & OAuth Credentials
# ==========================================
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Update this to your deployed backend URL: https://your-backend-domain.up.railway.app/auth/callback
GOOGLE_REDIRECT_URI=https://your-backend-domain.up.railway.app/auth/callback

# ==========================================
# Frontend Build Environment Variable (Vite)
# ==========================================
# Set VITE_API_BASE_URL when building frontend if backend is on a separate domain.
# If using Nginx reverse proxy, leave this blank.
VITE_API_BASE_URL=https://your-backend-domain.up.railway.app

# ==========================================
# Optional Storage & Authentik Config
# ==========================================
CHROMA_DATA_DIR=/app/data
# AUTHENTIK_CLIENT_ID=your_authentik_client_id
# AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret
# AUTHENTIK_METADATA_URL=https://your-authentik-domain/application/o/app/.well-known/openid-configuration
