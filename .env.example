# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db

# Security & JWT Configuration
SECRET_KEY=nexusai-secret-key-super-secure-jwt-2026
ALGORITHM=HS256

# Google Gemini & OAuth Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional Authentik OAuth Configuration
# AUTHENTIK_CLIENT_ID=your_authentik_client_id
# AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret
# AUTHENTIK_METADATA_URL=https://your-authentik-domain/application/o/app/.well-known/openid-configuration
